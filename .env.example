# ─────────────────────────────────────────────────────────────────────────
# Skyve Roofing — environment variables (Vercel).
# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────

# Canonical public origin (no trailing slash). Drives canonical/OG tags,
# robots.txt and sitemap.xml. Set to the real domain once DNS points at Vercel.
NEXT_PUBLIC_SITE_URL=https://skyve.net

# Lead intake endpoint. Native Vercel route handler (default). Leave unset to
# use /api/lead; override only if pointing at an external intake.
# NEXT_PUBLIC_LEAD_ENDPOINT=/api/lead

# ── Verascor CRM — REQUIRED before real traffic (leads forward here) ─────
# Without both, the form still submits but the lead is NOT delivered.
VERASCOR_API_URL=https://api.verascor.net/api/v1
VERASCOR_INTAKE_KEY=

# ── Optional interim safety net (used only if Verascor is not configured) ─
# A webhook (e.g. a Zapier/Make catch hook → your email) so no lead is lost
# while the CRM is being wired.
# LEAD_FALLBACK_WEBHOOK=

# ── Analytics / ad pixels (optional) ────────────────────────────────────
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
